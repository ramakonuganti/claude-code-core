  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$file\" == *.tf ]]; then ~/.claude/hooks/tf-lint.sh \"$file\" 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/agent-teams/hooks/cost-monitor.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/read-size-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent|TaskCreate|TeamCreate|AgentTeam.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/team-opus-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safety-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-claude-attribution.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/security_reminder_hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '~/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Task complete — ready for your review\" with title \"Claude Code\" sound name \"Glass\"'"
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/cost-tracker.js"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/daily-cost-report.sh"
          },
          {
            "type": "command",
            "command": "npx ccusage@latest daily 2>/dev/null | tail -20"
          },
          {
            "type": "command",
            "command": "[ $(date +%u) -eq 1 ] && echo '💰 It is Monday — run /cost-review for your weekly spend analysis' || true"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session-eval.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/the-fool-reminder.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/agent-teams/hooks/task-completed.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/cost-tracker.js"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-cost-gate.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/advisor-nudge.sh"
          }
        ]
      }
    ]
  }
}
